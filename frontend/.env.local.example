# Optional. Without this, GitHub API allows 60 requests/hour per IP.
# With a read-only PAT, 5000/hour. Any classic or fine-grained token with
# public repo read access is enough. Generate at:
#   https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. When set, repo cards get one-sentence AI summaries generated by
# Gemini (gemini-2.5-flash). Without this, summaries fall back to the
# repo's GitHub description. Generate at:
#   https://aistudio.google.com/app/apikey
# Server-only — never expose to the browser. NEVER commit the literal key.
GEMINI_API_KEY=
